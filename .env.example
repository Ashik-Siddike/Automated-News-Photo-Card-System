# Server & Runner Settings
PORT=3000
NODE_OPTIONS="--dns-result-order=ipv4first"

# News Pipeline Settings
MAX_CARDS_PER_RUN=3
TEMPLATE_STYLE=breaking
CARD_ASPECT_RATIO=square

# Optional: Google Gemini API Key for Headline polishing and summarization
GEMINI_API_KEY=

# Optional: Telegram Bot & Channel for automated photo card broadcasting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Custom Chrome executable path if not detected automatically
# CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
