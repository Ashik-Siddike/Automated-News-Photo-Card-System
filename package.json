{
  "name": "photo-card-project",
  "version": "1.0.0",
  "description": "Automated Bangladeshi News Photo Card Generator with Dynamic QR Codes",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --dns-result-order=ipv4first dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "web": "ts-node --transpile-only src/web/server.ts",
    "generate": "ts-node --transpile-only src/cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "es-object-atoms": "^1.1.2",
    "express": "^4.21.2",
    "puppeteer-core": "^24.4.0",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "side-channel": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
